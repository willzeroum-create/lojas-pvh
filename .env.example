# Copiar para `.env.local` e preencher com os valores do projecto Supabase
# (Dashboard → Project Settings → API Keys).

# URL do projecto — visível no browser
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Chave publishable (sb_publishable_...) — visível no browser, limitada por RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Chave secreta (sb_secret_...) — SÓ no servidor. Ignora RLS. Nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# Usada pelo importador de cardápio por foto (console). Opcional: sem ela o
# importador aceita apenas planilhas.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# URL pública da aplicação, sem barra final. Usada para links absolutos.
NEXT_PUBLIC_URL_BASE=http://localhost:3000

# Ligação directa à base de dados, só para `pnpm migrar` (Dashboard → Connect →
# Session pooler). Contém a senha da base: nunca sai desta máquina.
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxxxxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# No `pnpm dev` em localhost entra-se sem login, como o operador mais antigo.
# Pôr a 1 para voltar a ver o ecrã de login em dev. Em produção há sempre login.
# PVH_LOGIN_OBRIGATORIO=1
